APP_NAME="CRM 360 Colombia Birdfair"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://event.colombiabirdfair.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Producción (CyberPanel): MariaDB. Para desarrollo local puede usarse sqlite.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Solo para correos del sistema (recuperar contraseña). Los correos a inscritos usan Configuración › Correo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sitios que pueden mostrar el formulario de suscripción (separados por coma)
CRM_FORM_ORIGINS=https://colombiabirdfair.com,https://www.colombiabirdfair.com
CRM_QR_EMAILS_PER_HOUR=90
CRM_CERTIFICATE_EMAILS_PER_HOUR=90
CRM_SURVEY_EMAILS_PER_HOUR=90
# Portal de inscritos: correo de ayuda y claves de Cloudflare Turnstile (opcionales)
CRM_PORTAL_HELP_EMAIL=
CRM_TURNSTILE_SITE_KEY=
CRM_TURNSTILE_SECRET=
# Pases de Wallet con el QR (opcionales; sin claves no se muestran los botones)
CRM_WALLET_EVENT_NAME="Colombia Birdfair"
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_CERTIFICATE=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
GOOGLE_WALLET_CLASS=colombia-birdfair
